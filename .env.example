# PostgreSQL connection string — Supabase, Neon, Railway, or local Postgres all work.
DATABASE_URL="postgresql://user:password@localhost:5432/ultra_dev"

# Required — signs/verifies access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=""

# Required — rate limiting (auth.ts, inquiries.ts). Local: docker compose up
# starts one on localhost:6379. Production: Upstash or any Redis-compatible
# host. Rate limiting fails OPEN (see lib/rateLimit.ts) if this is
# unreachable, so a Redis outage degrades limits rather than taking the API
# down — but don't rely on that as a reason to skip setting this up.
REDIS_URL="redis://localhost:6379"

# OTP SMS provider (Termii). If unset in development, OTP codes are logged
# to the API console instead of sent as real SMS. If unset in PRODUCTION
# (NODE_ENV=production), getSmsProvider() throws instead — it will never
# silently log real verification codes to production server logs.
# TERMII_API_KEY=""

# Payments — lead billing (Paystack). Required for payments.initiateTopUp
# and the /api/webhooks/paystack route to function; both throw a clear
# error rather than faking success if this is unset.
PAYSTACK_SECRET_KEY=""

# Error monitoring. If unset, reportError() falls back to console.error —
# a real no-op, not a fake success (see lib/sentry.ts).
# SENTRY_DSN=""

# Phase 5 — file storage for listing photos and verification documents
# All four required together for uploads.presignListingMedia /
# presignVerificationDoc to work; each throws a clear error if unset.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL=""  # e.g. https://media.ultraapp.ng, or R2's default public bucket URL
# R2_PRIVATE_BUCKET_NAME=""  # SEPARATE bucket, no public binding — verification/KYC documents only. Remediation: was previously stored in the same public bucket as listing photos.

# Optimization Sprint A — analytics. Unset falls back to console-logging
# events (see lib/analytics.ts) rather than failing — analytics is the
# one integration in this codebase that's allowed to degrade quietly,
# since a missing key costs a dashboard, not a security property.
# POSTHOG_API_KEY=""
# POSTHOG_HOST=""  # defaults to https://app.posthog.com if unset

# Sprint 3 — Phase 2 (home services) freeze, per Sprint 1B Delta Audit's
# recommendation: "freeze public Phase 2 exposure" until Phase 1 clears its
# own security/trust gates. Fails CLOSED — unset or any value other than
# the literal string "true" means Phase 2's customer- and provider-facing
# web routes (/services, /bookings, /partner/*) render a "coming soon"
# page instead of the real feature, even though the code and API are both
# fully present. Mobile has the equivalent flag — see
# apps/mobile/app.config.js's PHASE2_ENABLED. Admin routes
# (/admin/provider-verification) are NOT gated by this — internal review
# of Phase 2 is a legitimate "separate development track" activity per
# the audit, distinct from public exposure.
NEXT_PUBLIC_PHASE2_ENABLED="false"
